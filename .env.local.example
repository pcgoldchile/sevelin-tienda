# Variables de entorno del proyecto sevelin-tienda.
# Copia este archivo a .env.local (nunca se commitea, ver .gitignore) y
# rellena los valores reales. Ver README-ECOMMERCE-SEVELIN.md sección 9.

# --- Supabase Web (proyecto NUEVO, propio de la tienda) ---
# NO son las credenciales de Supabase POS. Este proyecto solo tiene
# productos_web y pedidos_web (ver docs/README-SUPABASE-WEB.md).
SUPABASE_WEB_URL=https://xxxx.supabase.co
SUPABASE_WEB_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Cuentas de cliente (Supabase Auth) ---
# Anon key PÚBLICA (no la service_role de arriba) — sí puede llevar el
# prefijo NEXT_PUBLIC_, es la key diseñada para el navegador. Se saca de
# Supabase → Settings → API → Project URL / anon public. Sin estas dos, el
# checkout de invitado sigue funcionando igual, solo no hay registro/login.
NEXT_PUBLIC_SUPABASE_WEB_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_WEB_ANON_KEY=eyJhbGciOi...

# --- Frontend público (Fase 2) ---
# Datos de contacto reales del negocio (no son secretos, por eso van con valor
# por defecto acá mismo en vez de quedar vacíos). Si algún día cambian, basta
# con actualizarlos acá.
# WhatsApp: formato internacional sin "+" ni espacios. Se usa en el botón
# flotante y el footer. Si se deja vacío, ambos se ocultan en vez de mostrar
# un número inventado.
NEXT_PUBLIC_WHATSAPP_NUMBER=56935750828
# Instagram: URL completa del perfil. Si se deja vacío, el enlace del footer
# se oculta.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/sevelin.cl
# Correo donde los clientes ejercen sus derechos sobre sus datos (Ley
# 21.719, ver /privacidad). El Art. 11 exige un canal "establecido para
# este fin", así que /privacidad tiene sevelin.contacto@gmail.com como valor por
# defecto en el código: esta variable solo sirve para cambiarlo sin tocar
# código, NUNCA para dejarlo sin canal.
NEXT_PUBLIC_PRIVACIDAD_EMAIL=sevelin.contacto@gmail.com

# --- Sincronización con el POS ---
# Mismo valor que SYNC_SECRET en las variables de entorno de
# sevelin-pos-oficial (Vercel). Protege POST /api/sync/producto: lo llama
# el Database Webhook del Supabase POS, no una persona logueada.
SYNC_SECRET=cadena-larga-y-aleatoria-compartida-con-el-pos

# --- Checkout + pago + boleta (Fase 3) ---
# URL pública de esta tienda ya desplegada. Flow la necesita para construir
# urlReturn/urlConfirmation absolutas — sin proyecto Vercel real todavía,
# usa http://localhost:3000 en desarrollo (ver docs/SNAPSHOT.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ruta interna del POS que descuenta stock tras un pago confirmado (ver
# docs/CHANGELOG-V03.md). Mismo SYNC_SECRET de arriba, compartido con el POS.
POS_INTERNAL_API_URL=https://sevelin-pos-oficial.vercel.app/api/interno/ajustar-stock

# Flow (pasarela de pago, https://www.flow.cl/api / sandbox.flow.cl/api).
# Sin credenciales reales todavía — ver "Pendiente" en docs/SNAPSHOT.md.
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_BASE=https://sandbox.flow.cl/api

# OpenFactura (Haulmer) — emisión de boleta electrónica.
# DESHABILITADO A PROPÓSITO (no es una credencial que falta por circunstancia):
# cuesta ~$30.000/mes y por ahora no se justifica. El respaldo de una venta
# web es el comprobante de pago de Flow; boleta/factura se emite manual si el
# cliente la pide (ver src/lib/openfactura.ts). Dejar OPENFACTURA_API_KEY
# vacío desactiva la emisión automática sin frenar el checkout — para
# reactivarlo, solo hay que ponerle un valor real acá.
OPENFACTURA_API_KEY=
OPENFACTURA_API_BASE=https://dev-api.haulmer.com/v2

# OBSOLETA desde v17 — el despacho en Arica ya NO es una tarifa plana: se
# calcula por la distancia real de manejo desde la tienda (ver
# src/lib/tarifas-envio.ts). Se deja documentada solo para que nadie la
# reponga pensando que falta; el código ya no la lee.
# COSTO_ENVIO_PLANO=3990

# Coordenadas exactas de la tienda (San Rafael 896, Arica), origen de TODAS
# las distancias de despacho. Ya vienen por defecto en el código
# (src/lib/distancia.ts), confirmadas por el dueño el 30-08-2026. Solo hay
# que definirlas acá si el local se muda.
#
# IMPORTANTE: no las saques de un geocodificador. Nominatim resuelve
# "San Rafael 896, Arica" a un punto ~4 km al norte del local real, y como
# el origen corre todas las tarifas a la vez, el error es invisible: los
# precios salen plausibles, solo que mal. Sácalas de Google Maps (clic
# derecho sobre el local → copiar coordenadas).
# TIENDA_LAT=-18.4619
# TIENDA_LON=-70.2976

# --- Distancia real de despacho: Google Maps Platform (v7 — se probó
# LocationIQ/OpenStreetMap primero, pero esos datos no tienen el número de
# casa exacto para varias calles de Arica; ver src/lib/distancia.ts para
# el detalle completo). Ambas son APIs PAGADAS de Google Cloud (requieren
# facturación habilitada en el proyecto correspondiente a cada key); sin
# ellas el despacho local cae a estimación por línea recta (peor, no
# roto).
#
# Geocoding API — convierte la dirección escrita en coordenadas. OJO: su
# "Restricción de la aplicación" debe ser "Ninguna" o "Direcciones IP",
# NUNCA "Referencias HTTP" — esta llamada la hace el servidor, que no
# manda ese header.
GOOGLE_GEOCODING_API_KEY=
# Distance Matrix API — calcula la distancia real de manejo entre dos
# coordenadas.
GOOGLE_DISTANCE_MATRIX_API_KEY=
# Places API (New) — autocompletado de direcciones mientras el cliente
# escribe en el checkout (sugerencias en vivo + coordenadas exactas de la
# sugerencia elegida, sin pasar por Geocoding). Restricción de API: solo
# "Places API (New)" — misma llave o una aparte, cualquiera funciona.
GOOGLE_PLACES_API_KEY=

# --- Envío regional: Chilexpress (v6, reemplaza a Shipit) ---
# Convenio corporativo con tarifa preferencial. Mientras
# CHILEXPRESS_API_KEY_COTIZADOR esté vacío, el checkout usa
# COSTO_ENVIO_CHILEXPRESS_MOCK. Ver src/lib/chilexpress.ts.
#
# 3 suscripciones SEPARADAS en el portal de Chilexpress, cada una con su
# propia llave — la de una no sirve para las otras. **01-09-2026: llegaron
# las credenciales PRODUCTIVAS reales** (Soporte de Integraciones, tras
# asociar la TCC del dueño) y se confirmaron contra
# https://services.wschilexpress.com — georeferencia y cotización real
# (con `serviceValueDiscount`, el precio ya con el descuento del convenio)
# responden 200 con datos reales. Las keys de abajo son las PRODUCTIVAS:
# poner esto en Vercel activa el cobro real del courier fuera de Arica (deja
# de usarse COSTO_ENVIO_CHILEXPRESS_MOCK) — confirmar que es lo que se
# quiere antes de pegar los valores acá o en Vercel.
#
# API-COBERTURAS-CHILEXPRESS → resuelve comuna → countyCode (geo-referencia).
CHILEXPRESS_API_KEY_COBERTURAS=
#
# API-COTIZADOR-CHILEXPRESS → el endpoint que de verdad calcula el precio
# (rating/api/v1.0/rates/business, "Cotizador Empresa" — NO rates/courier,
# ver docs/CHANGELOG-V25.md).
CHILEXPRESS_API_KEY_COTIZADOR=
#
# API-ENVIOS-CHILEXPRESS → creación de órdenes de transporte/etiquetas. La
# key es válida (confirmada), pero el endpoint (transport-orders) NUNCA se
# probó de verdad: a diferencia de georeferencia/cotización, generar una OT
# real CREA un envío y factura a la TCC — no es de solo lectura. Este
# proyecto todavía no genera envíos reales, solo cotiza.
CHILEXPRESS_API_KEY_ENVIOS=
#
# Con las credenciales productivas de arriba, usar producción:
CHILEXPRESS_API_BASE=https://services.wschilexpress.com
# (Ambiente de pruebas, self-service, sin TCC: https://testservices.wschilexpress.com)
# Código de comuna (countyCode) de Chilexpress para Arica, origen de todos
# los envíos — confirmado contra la API real: "ARIC". Ya viene por defecto
# en el código (src/lib/envio.ts), esta variable solo lo sobreescribe si la
# tienda cambia de comuna de origen.
CHILEXPRESS_ORIGIN_COUNTY_CODE=
# Tarifa referencial (CLP) para cualquier comuna fuera de Arica mientras
# Chilexpress no esté conectado. Nunca puede quedar en 0 ni vacío.
COSTO_ENVIO_CHILEXPRESS_MOCK=6000

# --- Envío regional: Starken (v35) ---
# SEGUNDA opción de courier, junto a Chilexpress (nunca lo reemplaza) — el
# cliente ve las dos cotizaciones y elige. Documentación OFICIAL entregada
# por el dueño (developers.starken.cl) — solo cubre cotización
# (consultarTarifas), no hay endpoint de creación de envíos/etiquetas
# todavía. Ver src/lib/starken.ts.
#
# Sin STARKEN_RUT/STARKEN_CLAVE, el código usa las credenciales de PRUEBA
# que trae la propia documentación de Starken (ambiente QA) — para
# desactivar Starken del todo, poné las dos en blanco EXPLÍCITO acá (no
# basta con dejarlas comentadas).
STARKEN_RUT=
STARKEN_CLAVE=
# Con las credenciales de arriba, por defecto apunta al ambiente de PRUEBAS
# (QA) de Starken. "Una vez las pruebas en QA hayan finalizado, debe
# solicitar las credenciales para el ambiente productivo a su ejecutivo
# comercial" (texto literal de Starken) — cuando las tengas, esta variable
# se sobreescribe con la URL de producción real que te den.
STARKEN_API_BASE=https://restservices-qa.starken.cl/apiqa/starkenservices/rest
# Cuenta corriente Starken (convenio corporativo, tarifa preferencial) —
# opcional. Sin ella, se cotiza con el RUT de STARKEN_RUT en vez de cuenta
# (son excluyentes según la propia API de Starken).
STARKEN_CUENTA_CORRIENTE=
STARKEN_CUENTA_CORRIENTE_DV=

# --- Correo transaccional (Resend) ---
# Confirmación de pedido al cliente cuando el pago se confirma
# (POST /api/flow-webhook). Cuenta creada con sevelin.contacto@gmail.com
# (dashboard.resend.com). Sin RESEND_API_KEY, el checkout sigue
# funcionando igual — enviarCorreo() falla en silencio y solo deja un
# warning en el log, nunca bloquea el pago ni el pedido.
RESEND_API_KEY=
# Mientras no haya un dominio propio verificado en Resend, los envíos a
# clientes reales van a fallar — el dominio de prueba de Resend
# (onboarding@resend.dev) solo entrega a la cuenta que creó la API key.
RESEND_FROM=Sevelin <onboarding@resend.dev>

# --- Carritos abandonados (cron) ---
# Protege GET /api/cron/recordar-carritos — Vercel manda automáticamente
# "Authorization: Bearer <CRON_SECRET>" en cada ejecución programada
# (vercel.json) cuando esta variable está configurada en el proyecto; no
# hace falta ponerla en el header a mano. Sin ella, el cron responde 401 y
# no manda nada (mejor esfuerzo, no bloquea el checkout).
CRON_SECRET=cadena-larga-y-aleatoria

# --- Freno de tasa (Upstash Redis) ---
# Protege /api/autocompletar-direccion, /api/detalle-direccion y
# /api/cotizar-envio (Reporte de Seguridad Consolidado B, hallazgo #3/#5):
# esas 3 rutas llaman APIs PAGADAS de Google Maps Platform sin tope de
# presupuesto propio — sin este freno, un script puede generar costo
# ilimitado en la cuenta de Google Cloud. Crear una base gratis en
# https://console.upstash.com (Redis → REST API) y copiar acá las dos
# credenciales. SIN ellas, las 3 rutas siguen funcionando pero SIN freno
# (ver src/lib/rate-limit.ts) — no bloquea el checkout, pero conviene
# configurarlas antes de ir a producción real.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Fases futuras (NO usadas todavía) ---
# CORS_ORIGINS=https://sevelin.cl
