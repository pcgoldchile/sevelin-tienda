# Variables de entorno del proyecto sevelin-tienda.
# Copia este archivo a .env.local (nunca se commitea, ver .gitignore) y
# rellena los valores reales. Ver README-ECOMMERCE-SEVELIN.md sección 9.

# --- Supabase Web (proyecto NUEVO, propio de la tienda) ---
# NO son las credenciales de Supabase POS. Este proyecto solo tiene
# productos_web y pedidos_web (ver docs/README-SUPABASE-WEB.md).
SUPABASE_WEB_URL=https://xxxx.supabase.co
SUPABASE_WEB_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Frontend público (Fase 2) ---
# Datos de contacto reales del negocio (no son secretos, por eso van con valor
# por defecto acá mismo en vez de quedar vacíos). Si algún día cambian, basta
# con actualizarlos acá.
# WhatsApp: formato internacional sin "+" ni espacios. Se usa en el botón
# flotante y el footer. Si se deja vacío, ambos se ocultan en vez de mostrar
# un número inventado.
NEXT_PUBLIC_WHATSAPP_NUMBER=56935750828
# Instagram: URL completa del perfil. Si se deja vacío, el enlace del footer
# se oculta.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/sevelin.cl

# --- Sincronización con el POS ---
# Mismo valor que SYNC_SECRET en las variables de entorno de
# sevelin-pos-oficial (Vercel). Protege POST /api/sync/producto: lo llama
# el Database Webhook del Supabase POS, no una persona logueada.
SYNC_SECRET=cadena-larga-y-aleatoria-compartida-con-el-pos

# --- Checkout + pago + boleta (Fase 3) ---
# URL pública de esta tienda ya desplegada. Flow la necesita para construir
# urlReturn/urlConfirmation absolutas — sin proyecto Vercel real todavía,
# usa http://localhost:3000 en desarrollo (ver docs/SNAPSHOT.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ruta interna del POS que descuenta stock tras un pago confirmado (ver
# docs/CHANGELOG-V03.md). Mismo SYNC_SECRET de arriba, compartido con el POS.
POS_INTERNAL_API_URL=https://sevelin-pos-oficial.vercel.app/api/interno/ajustar-stock

# Flow (pasarela de pago, https://www.flow.cl/api / sandbox.flow.cl/api).
# Sin credenciales reales todavía — ver "Pendiente" en docs/SNAPSHOT.md.
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_BASE=https://sandbox.flow.cl/api

# OpenFactura (Haulmer) — emisión de boleta electrónica.
# Sin credenciales reales todavía — ver "Pendiente" en docs/SNAPSHOT.md.
OPENFACTURA_API_KEY=
OPENFACTURA_API_BASE=https://dev-api.haulmer.com/v2

# Tarifa de envío plana (CLP), mientras la cotización real (Haversine +
# Shipit) no exista (Fase 4). pedidos_web.costo_envio exige > 0 (ver
# supabase/01-productos-web-pedidos-web.sql), así que este valor nunca
# puede quedar en 0 ni vacío.
COSTO_ENVIO_PLANO=3990

# --- Fases futuras (NO usadas todavía) ---
# SHIPIT_API_KEY=                                                                            # Fase 4
# CORS_ORIGINS=https://sevelin.cl
